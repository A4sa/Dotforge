# [2]  SERIAL CONSOLE
# ============================================================================

# Open a serial console with picocom.
#   con                    → first USB serial port, 115200
#   con 1                  → /dev/ttyUSB1
#   con /dev/ttyACM0 1500000      (Rockchip default baud)
#   con ttyUSB1                   (the /dev/ prefix is optional)
#   con usb-FTDI_FT232R_...       (name from /dev/serial/by-id — stable)
#   con -l                 → also log to ~/serial_logs/<date>.log
# Exit picocom with Ctrl+A Ctrl+X.
con() {
    local dev="" baud="115200" log=0 arg
    for arg in "$@"; do
        case "$arg" in
            -h|--help)
                echo "Usage: con [device|index|by-id-name] [baud] [-l]"
                echo "  -l   log the session to ~/serial_logs/"
                echo "  Exit: Ctrl+A Ctrl+X     List ports: lsserial"
                return 0 ;;
            -l|--log) log=1 ;;
            [0-9]|[0-9][0-9]) dev="/dev/ttyUSB$arg" ;;
            [0-9][0-9][0-9]*) baud="$arg" ;;
            /dev/*) dev="$arg" ;;
            tty*) dev="/dev/$arg" ;;
            *) dev="/dev/serial/by-id/$arg" ;;
        esac
    done

    # Default: the first USB serial adapter that exists.
    if [ -z "$dev" ]; then
        local d
        for d in /dev/ttyUSB* /dev/ttyACM*; do
            [ -e "$d" ] && { dev="$d"; break; }
        done
    fi
    if [ -z "$dev" ] || [ ! -e "$dev" ]; then
        _df_err "No serial device ${dev:-found}. Plugged in? Try: lsserial"
        return 1
    fi
    if [ ! -r "$dev" ] || [ ! -w "$dev" ]; then
        _df_err "No permission for $dev."
        echo "  Fix once: sudo usermod -aG dialout $USER   (then log out and back in)"
        return 1
    fi
    if ! command -v picocom &>/dev/null; then
        _df_err "picocom not installed: sudo apt install picocom"
        return 1
    fi

    local opts=(-b "$baud" --flow=none --quiet)
    if [ "$log" = 1 ]; then
        mkdir -p "$HOME/serial_logs"
        local logfile
        logfile="$HOME/serial_logs/$(basename "$dev")_$(date +%Y-%m-%d_%H-%M-%S).log"
        opts+=(--logfile "$logfile")
        echo "Logging to $logfile"
    fi
    echo "Connecting to $dev @ $baud  (exit: Ctrl+A Ctrl+X)"
    picocom "${opts[@]}" "$dev"
}

# List serial ports with their USB adapter type and stable by-id name.
lsserial() {
    local found=0 dev name drv byid link
    for dev in /dev/ttyUSB* /dev/ttyACM* /dev/ttyAMA* /dev/ttymxc* /dev/ttyS[0-9]*; do
        [ -e "$dev" ] || continue
        name="$(basename "$dev")"
        # Skip the dozens of legacy /dev/ttyS* with no real UART behind them.
        if [[ "$name" == ttyS* ]] && [ ! -e "/sys/class/tty/$name/device/driver" ]; then
            continue
        fi
        case "$name" in ttyS*) [ "$(cat "/sys/class/tty/$name/type" 2>/dev/null)" = 0 ] && continue ;; esac
        drv="$(basename "$(readlink -f "/sys/class/tty/$name/device/driver" 2>/dev/null)" 2>/dev/null)"
        byid=""
        for link in /dev/serial/by-id/*; do
            [ "$(readlink -f "$link" 2>/dev/null)" = "$dev" ] && byid="$(basename "$link")"
        done
        printf '%-14s %-12s %s\n' "$dev" "${drv:-?}" "$byid"
        found=1
    done
    [ "$found" = 0 ] && echo "No serial ports found."
    if ! id -nG | grep -qw dialout; then
        _df_warn "You are not in the 'dialout' group: sudo usermod -aG dialout $USER"
    fi
}


# ============================================================================
# [3]  ADB — ANDROID DEBUG BRIDGE
# ============================================================================
# Multiple devices? export ANDROID_SERIAL=<serial from 'adb devices'>

# Push a file to the device; make it executable if it is executable locally.
#   adbpush ./my_test /data/local/tmp/          (into a directory)
#   adbpush ./my_test /data/local/tmp/my_test2  (to a full path)
adbpush() {
    if [ -z "$1" ] || [ -z "$2" ] || [ "$1" = "-h" ]; then
        echo "Usage: adbpush <local_file> <remote_dir/ | remote_path>"
        echo "  e.g. adbpush ./my_test /data/local/tmp/"
        return 1
    fi
    if [ ! -f "$1" ]; then
        _df_err "Error: '$1' does not exist or is not a file"
        return 1
    fi
    local src="$1" dst="$2" target
    # Is the destination a directory on the device?
    if [[ "$dst" == */ ]] || adb shell "[ -d \"$dst\" ]" 2>/dev/null; then
        target="${dst%/}/$(basename "$src")"
    else
        target="$dst"
    fi
    adb push "$src" "$target" || return 1
    if [ -x "$src" ]; then
        adb shell chmod 755 "'$target'" || return 1
        echo "Pushed (+x): $target"
    else
        echo "Pushed: $target"
    fi
}

# Pull a file from the ADB device to the current directory.
adbpull() {
    if [ -z "$1" ] || [ "$1" = "-h" ]; then
        echo "Usage: adbpull <remote_file> [local_destination]"
        echo "  e.g. adbpull /data/local/tmp/output.log"
        echo "  e.g. adbpull /data/local/tmp/output.log ~/logs/"
        return 1
    fi
    local dest="${2:-.}"
    adb pull "$1" "$dest" && echo "Pulled: $1 → $dest"
}


