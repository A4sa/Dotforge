# [1]  CROSS-COMPILATION
# ============================================================================

# Set the cross-compilation toolchain for a target architecture.
#   xc arm64                       → ARCH=arm64  CROSS_COMPILE=aarch64-linux-gnu-
#   xc arm64 aarch64-none-linux-gnu
#   xc arm   arm-linux-gnueabihf
#   xc riscv riscv64-linux-gnu
#   xc arm64 llvm                  → ARCH=arm64  LLVM=1 (clang, no CROSS_COMPILE)
#
# Prefer a per-tree .envrc with direnv over setting this in ~/.bash_local:
# an exported ARCH also affects native builds (host tools, DKMS, other repos).
xc() {
    if [ -z "$1" ] || [ "$1" = "-h" ]; then
        echo "Usage: xc <ARCH> [CROSS_COMPILE_PREFIX | llvm]"
        echo ""
        echo "  Examples:"
        echo "    xc arm64                    (default prefix aarch64-linux-gnu-)"
        echo "    xc arm    arm-linux-gnueabihf"
        echo "    xc riscv  riscv64-linux-gnu"
        echo "    xc arm64  llvm              (clang: LLVM=1)"
        echo ""
        echo "  Current: ARCH=${ARCH:-unset}  CROSS_COMPILE=${CROSS_COMPILE:-unset}  LLVM=${LLVM:-unset}"
        return 1
    fi

    # Kernel ARCH names differ from GNU triplets — fix the common mix-ups.
    local arch="$1"
    case "$arch" in
        aarch64)        arch=arm64 ;;
        armhf|armv7*)   arch=arm ;;
        x86_64|amd64|i?86) arch=x86 ;;
        riscv64|riscv32) arch=riscv ;;
    esac
    [ "$arch" != "$1" ] && _df_warn "Note: kernel ARCH for '$1' is '$arch'"

    local prefix="${2:-}"
    if [ -z "$prefix" ]; then
        case "$arch" in
            arm64) prefix=aarch64-linux-gnu ;;
            arm)   prefix=arm-linux-gnueabihf ;;
            riscv) prefix=riscv64-linux-gnu ;;
            x86)   prefix="" ;;
            *)     _df_err "No default prefix for ARCH=$arch — pass one."; return 1 ;;
        esac
    fi

    export ARCH="$arch"
    if [ "$prefix" = "llvm" ]; then
        unset CROSS_COMPILE
        export LLVM=1
        command -v clang &>/dev/null || _df_warn "Warning: clang not found in PATH"
    elif [ -n "$prefix" ]; then
        unset LLVM
        export CROSS_COMPILE="${prefix%-}-"
        if ! command -v "${CROSS_COMPILE}gcc" &>/dev/null; then
            _df_warn "Warning: ${CROSS_COMPILE}gcc not found in PATH — install the toolchain or fix PATH"
        fi
    else
        unset CROSS_COMPILE LLVM
    fi
    xc-show
}

# Show the currently active cross-compilation toolchain.
xc-show() {
    if [ -z "$ARCH" ] && [ -z "$CROSS_COMPILE" ] && [ -z "$LLVM" ]; then
        echo "No cross-compile toolchain set (native build)"
        return 0
    fi
    echo "ARCH          = ${ARCH:-unset}"
    echo "CROSS_COMPILE = ${CROSS_COMPILE:-unset}"
    [ -n "$LLVM" ] && echo "LLVM          = $LLVM"
    if [ -n "$CROSS_COMPILE" ] && command -v "${CROSS_COMPILE}gcc" &>/dev/null; then
        echo "Compiler      = $("${CROSS_COMPILE}gcc" --version | head -1)"
        echo "              ( $(command -v "${CROSS_COMPILE}gcc") )"
    fi
}

# Clear the cross-compilation environment (return to native build).
xc-clear() {
    unset ARCH CROSS_COMPILE LLVM
    echo "Cross-compile env cleared — now building natively"
}


