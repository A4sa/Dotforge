# ============================================================================
# [1]  CROSS-COMPILATION
# ============================================================================

# Set the cross-compilation toolchain for a target architecture.
xc() {
    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Usage: xc <ARCH> <CROSS_COMPILE_PREFIX>"
        echo ""
        echo "  Examples:"
        echo "    xc arm64  aarch64-linux-gnu"
        echo "    xc arm    arm-linux-gnueabihf"
        echo "    xc riscv  riscv64-linux-gnu"
        echo ""
        echo "  Current: ARCH=${ARCH:-unset}  CROSS_COMPILE=${CROSS_COMPILE:-unset}"
        return 1
    fi
    export ARCH="$1"
    local prefix="${2%-}"
    export CROSS_COMPILE="${prefix}-"
    echo "Toolchain set:"
    echo "  ARCH          = $ARCH"
    echo "  CROSS_COMPILE = $CROSS_COMPILE"
}

# Show the currently active cross-compilation toolchain.
xc-show() {
    if [ -z "$ARCH" ] && [ -z "$CROSS_COMPILE" ]; then
        echo "No cross-compile toolchain set (native build)"
    else
        echo "ARCH          = ${ARCH:-unset}"
        echo "CROSS_COMPILE = ${CROSS_COMPILE:-unset}"
    fi
}

# Clear the cross-compilation environment (return to native build).
xc-clear() {
    unset ARCH CROSS_COMPILE
    echo "Cross-compile env cleared — now building natively"
}


# ============================================================================
# [2]  ADB — ANDROID DEBUG BRIDGE
# ============================================================================

# Push a file to the ADB device and set executable permissions.
adbpush() {
    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Usage: adbpush <local_file> <remote_path>"
        echo "  e.g. adbpush ./my_driver /data/local/tmp/"
        return 1
    fi
    if [ ! -f "$1" ]; then
        echo "Error: '$1' does not exist or is not a file"
        return 1
    fi
    local filename
    filename=$(basename "$1")
    adb push "$1" "$2" && adb shell chmod +x "$2/$filename"
    echo "Pushed and chmod +x: $2/$filename"
}

# Pull a file from the ADB device to the current directory.
adbpull() {
    if [ -z "$1" ]; then
        echo "Usage: adbpull <remote_file> [local_destination]"
        echo "  e.g. adbpull /data/local/tmp/output.log"
        echo "  e.g. adbpull /data/local/tmp/output.log ~/logs/"
        return 1
    fi
    local dest="${2:-.}"
    adb pull "$1" "$dest" && echo "Pulled: $1 → $dest"
}


# ============================================================================
# [3]  KERNEL / BSP HELPERS
# ============================================================================

# Search for a kernel config option by name in .config.
kgrep() {
    if [ -z "$1" ]; then
        echo "Usage: kgrep <CONFIG_OPTION>"
        echo "  e.g. kgrep USB_SERIAL"
        return 1
    fi
    # Search upward for .config starting from current dir
    local dir="$PWD"
    local config=""
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/.config" ]; then
            config="$dir/.config"
            break
        fi
        dir=$(dirname "$dir")
    done
    if [ -z "$config" ]; then
        echo "No .config found in any parent directories"
        return 1
    fi
    echo "Searching: $config"
    grep -i "$1" "$config" || echo "No match for '$1'"
}

# Check if a kernel module is currently loaded.
modcheck() {
    if [ -z "$1" ]; then
        echo "Usage: modcheck <module_name>"
        echo "  e.g. modcheck i2c_dev"
        return 1
    fi
    # Normalize dashes to underscores for searching
    local query="${1//-/_}"
    local matched_mod
    matched_mod=$(lsmod | sed 's/-/_/g' | grep -i "^${query}\b" | awk '{print $1}')
    if [ -n "$matched_mod" ]; then
        echo "LOADED:   $1 (as $matched_mod)"
        lsmod | grep -i "^${matched_mod}\b"
    else
        echo "NOT LOADED: $1"
    fi
}

# Show dmesg output filtered by a keyword.
dlog() {
    if [ -z "$1" ]; then
        echo "Usage: dlog <keyword>"
        echo "  e.g. dlog i2c"
        echo "  e.g. dlog error"
        return 1
    fi
    sudo dmesg -T | grep -i "$1"
}

# Unload and reload a kernel module in one command.
rmmod_insmod() {
    if [ -z "$1" ]; then
        echo "Usage: rmmod_insmod <module_name>"
        echo "  e.g. rmmod_insmod my_driver"
        return 1
    fi
    local mod="$1"
    # Remove .ko extension if provided
    mod="${mod%.ko}"
    # Normalize dashes/underscores for module check
    local query="${mod//-/_}"

    local matched_mod
    matched_mod=$(lsmod | sed 's/-/_/g' | grep -i "^${query}\b" | awk '{print $1}')

    if [ -n "$matched_mod" ]; then
        # Use the name found in lsmod to rmmod
        sudo rmmod "$matched_mod" && echo "Removed: $matched_mod" || return 1
    else
        echo "Note: $mod was not loaded, skipping rmmod"
    fi

    if [ -f "${mod}.ko" ]; then
        sudo insmod "${mod}.ko" && echo "Loaded:  ${mod}.ko"
    elif [ -f "${mod//-/_}.ko" ]; then
        sudo insmod "${mod//-/_}.ko" && echo "Loaded:  ${mod//-/_}.ko"
    else
        echo "Error: ${mod}.ko not found in current directory"
        return 1
    fi
}


# ============================================================================
# [4]  WORKSPACE HELPERS
# ============================================================================

# Create a directory and immediately cd into it.
mkcd() {
    if [ -z "$1" ]; then
        echo "Usage: mkcd <directory_name>"
        return 1
    fi
    mkdir -p "$1" && cd "$1" || return 1
}

# Move up N directory levels.
up() {
    local levels="${1:-1}"
    local path=""
    for _ in $(seq 1 "$levels"); do
        path="../$path"
    done
    cd "$path" || return 1
}

# Fuzzy-search directories and cd into the selected one.
fcd() {
    local target
    target=$(find . -type d -not -path '*/\.*' -not -path '*/build*' \
        2>/dev/null | fzf --preview 'ls {}') && cd "$target" || return 1
}

# Fuzzy-search files and open the selected one in Vim.
vf() {
    local file
    file=$(fzf --preview="bat --style=numbers --color=always {}" "$@") \
        && vim "$file"
}

# Extract any archive format with one command.
extract() {
    if [ -z "$1" ]; then
        echo "Usage: extract <archive_file>"
        return 1
    fi
    if [ ! -f "$1" ]; then
        echo "Error: '$1' is not a file"
        return 1
    fi
    case "$1" in
        *.tar.bz2)  tar xjf "$1"     ;;
        *.tar.gz)   tar xzf "$1"     ;;
        *.tar.xz)   tar xJf "$1"     ;;
        *.tar.zst)  tar --zstd -xf "$1" ;;
        *.bz2)      bunzip2 "$1"     ;;
        *.gz)       gunzip "$1"      ;;
        *.zip)      unzip "$1"       ;;
        *.7z)       7z x "$1"        ;;
        *.xz)       unxz "$1"        ;;
        *.rar)      unrar x "$1"     ;;
        *.tar)      tar xf "$1"      ;;
        *)
            echo "Unknown format: '$1'"
            echo "Supported: tar.gz tar.bz2 tar.xz tar.zst bz2 gz zip 7z xz rar tar"
            return 1
            ;;
    esac
}


# ============================================================================
# [5]  GIT HELPERS
# ============================================================================

# Sync the current branch — fetch + rebase in one step.
gsync() {
    local branch
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [ -z "$branch" ]; then
        echo "Error: not inside a git repository"
        return 1
    fi
    echo "Syncing branch: $branch"
    git fetch origin && git rebase "origin/$branch"
}

# Pretty one-line git log with graph, date, and author.
glog() {
    git log --oneline --graph --decorate \
        --format="%C(yellow)%h%C(reset) %C(blue)%ad%C(reset) %C(green)%an%C(reset) %s" \
        --date=short "$@"
}



