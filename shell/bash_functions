# [4]  KERNEL / BSP HELPERS
# ============================================================================

# Search for a kernel config option.
#   kgrep USB_SERIAL       → nearest .config (honours $KBUILD_OUTPUT / O=)
#   kgrep -r USB_SERIAL    → the RUNNING kernel (/proc/config.gz or /boot)
kgrep() {
    if [ -z "$1" ] || [ "$1" = "-h" ]; then
        echo "Usage: kgrep [-r] <CONFIG_OPTION>"
        echo "  e.g. kgrep USB_SERIAL       (build tree .config)"
        echo "       kgrep -r USB_SERIAL    (running kernel)"
        return 1
    fi
    if [ "$1" = "-r" ]; then
        shift
        local pattern="${1#CONFIG_}"
        if [ -r /proc/config.gz ]; then
            echo "Searching: /proc/config.gz"
            zgrep -i "CONFIG_[A-Z0-9_]*${pattern}" /proc/config.gz || echo "No match for '$1'"
        elif [ -r "/boot/config-$(uname -r)" ]; then
            echo "Searching: /boot/config-$(uname -r)"
            grep -i "CONFIG_[A-Z0-9_]*${pattern}" "/boot/config-$(uname -r)" || echo "No match for '$1'"
        else
            _df_err "No config for the running kernel (enable CONFIG_IKCONFIG_PROC)"
            return 1
        fi
        return 0
    fi

    local config=""
    if [ -n "$KBUILD_OUTPUT" ] && [ -f "$KBUILD_OUTPUT/.config" ]; then
        config="$KBUILD_OUTPUT/.config"
    else
        local dir
        dir=$(_df_find_up .config) && config="$dir/.config"
    fi
    if [ -z "$config" ]; then
        _df_err "No .config found here or in parent dirs (set KBUILD_OUTPUT for O= builds)"
        return 1
    fi
    echo "Searching: $config"
    grep -i "CONFIG_[A-Z0-9_]*${1#CONFIG_}" "$config" || echo "No match for '$1'"
}

# Is a kernel module loaded — or built into the running kernel?
modcheck() {
    if [ -z "$1" ] || [ "$1" = "-h" ]; then
        echo "Usage: modcheck <module_name>"
        echo "  e.g. modcheck i2c_dev"
        return 1
    fi
    # The kernel always reports module names with underscores.
    local name="${1%.ko}"
    name="${name##*/}"
    name="${name//-/_}"
    if grep -q "^${name} " /proc/modules 2>/dev/null; then
        echo "LOADED:     $name"
        grep "^${name} " /proc/modules | awk '{printf "  size=%s  refcount=%s  used_by=%s\n", $2, $3, $4}'
    elif grep -qE "/${name//_/[-_]}\.ko" "/lib/modules/$(uname -r)/modules.builtin" 2>/dev/null; then
        echo "BUILT-IN:   $name (compiled into the kernel, =y)"
    else
        echo "NOT LOADED: $name"
        modinfo "$name" &>/dev/null && echo "  (available: sudo modprobe $name)"
        return 1
    fi
}

# Show dmesg output filtered by a keyword (case-insensitive regex).
#   dlog i2c          → matching lines so far
#   dlog -f usb       → follow new matching lines live
dlog() {
    if [ -z "$1" ] || [ "$1" = "-h" ]; then
        echo "Usage: dlog [-f] <keyword>"
        echo "  e.g. dlog i2c      dlog -f 'usb|xhci'"
        return 1
    fi
    if [ "$1" = "-f" ]; then
        shift
        sudo dmesg -w | grep --line-buffered -iE --color=auto "$1"
    else
        sudo dmesg | grep -iE --color=auto "$1"
    fi
}

# Reload a kernel module from a .ko file, passing module parameters through.
#   rmmod_insmod my_driver                   (./my_driver.ko)
#   rmmod_insmod out/my-driver.ko debug=1
rmmod_insmod() {
    if [ -z "$1" ] || [ "$1" = "-h" ]; then
        echo "Usage: rmmod_insmod <module[.ko] | path/to/module.ko> [param=value ...]"
        echo "  e.g. rmmod_insmod my_driver debug=1"
        return 1
    fi
    local ko="$1"; shift
    [[ "$ko" != *.ko ]] && ko="${ko}.ko"
    # Accept both my-driver.ko and my_driver.ko spellings.
    if [ ! -f "$ko" ] && [ -f "${ko//-/_}" ]; then
        ko="${ko//-/_}"
    elif [ ! -f "$ko" ] && [ -f "${ko//_/-}" ]; then
        ko="${ko//_/-}"
    fi
    # Check the file BEFORE unloading — a typo must not leave you with no driver.
    if [ ! -f "$ko" ]; then
        _df_err "Error: $ko not found"
        return 1
    fi

    # Real module name from the .ko (it can differ from the file name).
    local name
    name=$(modinfo -F name "$ko" 2>/dev/null)
    [ -z "$name" ] && { name="$(basename "$ko" .ko)"; name="${name//-/_}"; }

    if grep -q "^${name} " /proc/modules; then
        sudo rmmod "$name" || { _df_err "rmmod $name failed (in use? check: lsmod | grep $name)"; return 1; }
        echo "Removed: $name"
    else
        echo "Note: $name was not loaded, skipping rmmod"
    fi

    local rc=0
    if sudo insmod "$ko" "$@"; then
        _df_ok "Loaded:  $ko $*"
    else
        rc=$?
        _df_err "insmod failed ($rc) — kernel log:"
    fi
    sudo dmesg | tail -n 10
    return "$rc"
}

# Run make and keep a log in build.log (exit status of make is preserved).
#   mkl                  mkl -C linux O=out Image dtbs
#   buildlogerr          → errors/warnings from the last run
mkl() {
    echo "### $(date '+%F %T')  make -j$(nproc) $*  ARCH=${ARCH:-} CROSS_COMPILE=${CROSS_COMPILE:-}" > build.log
    command make -j"$(nproc)" "$@" 2>&1 | tee -a build.log
    local rc=${PIPESTATUS[0]}
    if [ "$rc" -eq 0 ]; then
        _df_ok "Build OK  (log: build.log)"
    else
        _df_err "Build FAILED ($rc). First errors:"
        grep -nE "error:|Error [0-9]|undefined reference" build.log | head -10
    fi
    return "$rc"
}

# Build cscope / ctags indexes.
# In a kernel or U-Boot tree this uses the kernel's own target, which indexes
# only the current $ARCH (no 20x duplicate definitions from other arch/ dirs)
# and includes assembly (.S) and Kconfig.
mkcs() {
    local kroot
    if kroot=$(_df_kernel_root); then
        echo "Kernel tree: $kroot  (ARCH=${ARCH:-host})"
        command make -C "$kroot" -s cscope ${ARCH:+ARCH=$ARCH} && echo "cscope index rebuilt"
        return
    fi
    find . \( -name .git -o -name build -o -name out -o -name node_modules \) -prune \
        -o -type f \( -name '*.[chsS]' -o -name '*.cpp' -o -name '*.hpp' -o -name '*.cc' \) -print \
        > cscope.files
    cscope -b -q -k -i cscope.files && echo "cscope index rebuilt ($(wc -l < cscope.files) files)"
}

mktags() {
    local kroot
    if kroot=$(_df_kernel_root); then
        command make -C "$kroot" -s tags ${ARCH:+ARCH=$ARCH} && echo "ctags index rebuilt"
        return
    fi
    ctags -R --exclude=.git --exclude=build --exclude=out --exclude='*.o' --exclude='*.ko' . \
        && echo "ctags index rebuilt"
}

# Rebuild both. In Vim run :CscopeReload afterwards.
mkidx() { mkcs && mktags; }

# Generate compile_commands.json for clangd (go-to-definition in Vim).
#   Kernel / U-Boot: needs a build first (uses the .cmd files it leaves).
#   Anything else:   wraps the build with 'bear'.
#   kccdb                 kccdb O=out        kccdb -- make -C app
kccdb() {
    local kroot
    if kroot=$(_df_kernel_root); then
        if [ -f "$kroot/scripts/clang-tools/gen_compile_commands.py" ]; then
            local outdir="${KBUILD_OUTPUT:-$kroot}"
            local a
            for a in "$@"; do [[ "$a" == O=* ]] && outdir="${a#O=}"; done
            python3 "$kroot/scripts/clang-tools/gen_compile_commands.py" -d "$outdir" \
                -o "$kroot/compile_commands.json" \
                && echo "Wrote $kroot/compile_commands.json"
            return
        fi
    fi
    if ! command -v bear &>/dev/null; then
        _df_err "bear not installed: sudo apt install bear"
        return 1
    fi
    [ "$1" = "--" ] && shift
    if [ $# -gt 0 ]; then bear -- "$@"; else bear -- make -j"$(nproc)"; fi
}

# Run the kernel's checkpatch.pl.
#   kcheck                 → the last commit (HEAD)
#   kcheck HEAD~3          → the last 3 commits, one by one
#   kcheck drivers/foo.c   → a file
#   kcheck 0001-*.patch    → patch files
kcheck() {
    local kroot
    kroot=$(_df_kernel_root) || { _df_err "Not inside a kernel/U-Boot tree"; return 1; }
    local cp="$kroot/scripts/checkpatch.pl"
    [ -x "$cp" ] || { _df_err "$cp not found"; return 1; }
    if [ $# -eq 0 ]; then
        "$cp" --strict -g HEAD
    elif [ -f "$1" ] && [[ "$1" == *.patch ]]; then
        "$cp" --strict "$@"
    elif [ -f "$1" ]; then
        "$cp" --strict --no-tree -f "$@"
    else
        "$cp" --strict -g "$1..HEAD"
    fi
}

# Decompile a device tree blob back to source — check what the board really got.
#   dtsdump board.dtb          → board.dtb as DTS on stdout
#   dtsdump                    → the RUNNING device tree (/sys/firmware/devicetree)
dtsdump() {
    if [ "$1" = "-h" ]; then
        echo "Usage: dtsdump [file.dtb|file.dtbo]   (no arg = live tree on this board)"
        return 0
    fi
    command -v dtc &>/dev/null || { _df_err "dtc not installed: sudo apt install device-tree-compiler"; return 1; }
    if [ -n "$1" ]; then
        dtc -q -I dtb -O dts -s "$1"
    elif [ -d /sys/firmware/devicetree/base ]; then
        dtc -q -I fs -O dts -s /sys/firmware/devicetree/base
    else
        _df_err "No live device tree here (x86/ACPI host?). Pass a .dtb file."
        return 1
    fi
}


# ============================================================================
# [5]  WORKSPACE HELPERS
# ============================================================================

# Create a directory and immediately cd into it.
mkcd() {
    if [ -z "$1" ]; then
        echo "Usage: mkcd <directory_name>"
        return 1
    fi
    mkdir -p -- "$1" && cd -- "$1" || return 1
}

# Move up N directory levels.  up  /  up 3
up() {
    local levels="${1:-1}"
    if ! [[ "$levels" =~ ^[0-9]+$ ]]; then
        echo "Usage: up [N]"
        return 1
    fi
    local p="" i
    for ((i = 0; i < levels; i++)); do p+="../"; done
    cd "${p:-.}" || return 1
}

# Fuzzy-search directories and cd into the selected one.
fcd() {
    local target
    target=$(find . \( -name .git -o -name node_modules -o -name __pycache__ \) -prune \
        -o -type d -print 2>/dev/null | fzf --preview 'ls -A {}') && cd "$target" || return 1
}

# Fuzzy-search files and open the selected one in Vim.
vf() {
    local file
    file=$(fzf --preview="bat --style=numbers --color=always {} 2>/dev/null || cat {}" "$@") \
        && vim "$file"
}

# fzf with syntax-highlighted preview; prints the chosen path.
ff() {
    fzf --preview="bat --style=numbers --color=always {} 2>/dev/null || cat {}" "$@"
}

# Activate ./venv or ./.venv (create one with: python3 -m venv .venv).
va() {
    local d
    for d in .venv venv; do
        if [ -f "$d/bin/activate" ]; then
            source "$d/bin/activate"
            return 0
        fi
    done
    _df_err "No venv/ or .venv/ here. Create one: python3 -m venv .venv"
    return 1
}

# Extract any archive format with one command. Keeps the original for
# single-file compressors (handy for rootfs / sdcard images).
extract() {
    if [ -z "$1" ] || [ "$1" = "-h" ]; then
        echo "Usage: extract <archive_file>"
        return 1
    fi
    if [ ! -f "$1" ]; then
        _df_err "Error: '$1' is not a file"
        return 1
    fi
    case "$1" in
        *.tar.bz2|*.tbz2) tar xjf "$1"              ;;
        *.tar.gz|*.tgz)   tar xzf "$1"              ;;
        *.tar.xz|*.txz)   tar xJf "$1"              ;;
        *.tar.zst)        tar --zstd -xf "$1"       ;;
        *.tar.lz4)        lz4 -dc "$1" | tar xf -   ;;
        *.tar)            tar xf "$1"               ;;
        *.cpio.gz)        gunzip -c "$1" | cpio -idmv ;;
        *.bz2)            bunzip2 -k "$1"           ;;
        *.gz)             gunzip -k "$1"            ;;
        *.xz)             unxz -k "$1"              ;;
        *.zst)            zstd -dk "$1"             ;;
        *.lz4)            lz4 -d "$1"               ;;
        *.zip)            unzip "$1"                ;;
        *.7z)             7z x "$1"                 ;;
        *.rar)            unrar x "$1"              ;;
        *.cpio)           cpio -idmv < "$1"         ;;
        *)
            _df_err "Unknown format: '$1'"
            echo "Supported: tar(.gz/.bz2/.xz/.zst/.lz4) gz bz2 xz zst lz4 zip 7z rar cpio"
            return 1
            ;;
    esac
}


