# Sync the current branch with its upstream — fetch + rebase, keeping any
# uncommitted work (autostash). Works with any remote, not just 'origin'.
gsync() {
    git rev-parse --git-dir &>/dev/null || { _df_err "Error: not inside a git repository"; return 1; }
    local upstream
    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null) || {
        _df_err "Branch has no upstream. Set one: git branch -u origin/<branch>"
        return 1
    }
    echo "Syncing $(git branch --show-current) onto $upstream"
    git fetch "${upstream%%/*}" && git rebase --autostash "$upstream"
}

# Pretty one-line git log with graph, date, and author.
glog() {
    git log --graph --decorate \
        --format="%C(yellow)%h%C(reset) %C(blue)%ad%C(reset) %C(green)%an%C(reset)%C(auto)%d%C(reset) %s" \
        --date=short "$@"
}


