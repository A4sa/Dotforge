# [7]  SYSTEM INFO
# ============================================================================

# Print a quick system summary — works on x86 hosts and ARM boards.
sysinfo() {
    local model cores sockets
    model=$(LC_ALL=C lscpu 2>/dev/null | awk -F: '/^Model name/ {sub(/^ +/, "", $2); print $2; exit}')
    # ARM kernels often have no "Model name" in lscpu — fall back to /proc/cpuinfo.
    [ -n "$model" ] || model=$(awk -F: '/^(model name|Hardware|Processor)/ {sub(/^ +/, "", $2); print $2; exit}' /proc/cpuinfo 2>/dev/null)
    cores=$(LC_ALL=C lscpu -p=core,socket 2>/dev/null | grep -v '^#' | sort -u | wc -l)
    echo "================================================"
    echo " System Information"
    echo "================================================"
    echo " OS       : $(. /etc/os-release 2>/dev/null && echo "${PRETTY_NAME:-unknown}")"
    if [ -r /proc/device-tree/model ]; then
        echo " Board    : $(tr -d '\0' < /proc/device-tree/model)"
    fi
    echo " Kernel   : $(uname -r)"
    echo " Arch     : $(uname -m)"
    echo " Hostname : $(hostname)"
    echo " CPU      : ${model:-unknown}"
    echo " Cores    : ${cores:-?} physical / $(nproc --all) logical"
    echo " RAM      : $(command free -h | awk '/^Mem:/ {print $3 " used / " $2 " total"}')"
    echo " Disk     : $(command df -h / | awk 'NR==2 {print $3 " used / " $2 " total (" $5 " full)"}')"
    if [ -n "$ARCH$CROSS_COMPILE$LLVM" ]; then
        echo " Target   : ARCH=${ARCH:-} CROSS_COMPILE=${CROSS_COMPILE:-} ${LLVM:+LLVM=$LLVM}"
    fi
    echo "================================================"
}

# Show which process is listening on a given port.  portinfo 8080
portinfo() {
    if [ -z "$1" ] || [ "$1" = "-h" ]; then
        echo "Usage: portinfo <port_number>"
        echo "  e.g. portinfo 8080"
        return 1
    fi
    if ! [[ "$1" =~ ^[0-9]+$ ]] || [ "$1" -gt 65535 ]; then
        _df_err "Not a valid port number: $1"
        return 1
    fi
    local out
    out=$(sudo ss -tulnpH "sport = :$1")
    if [ -n "$out" ]; then echo "$out"; else echo "Nothing listening on port $1"; fi
}

# Show CPU load per core.
cpuload() {
    if command -v mpstat &>/dev/null; then
        mpstat -P ALL 1 3
    else
        echo "mpstat not found. Install with: sudo apt install sysstat"
        echo "Falling back to /proc/loadavg:"
        cat /proc/loadavg
    fi
}


