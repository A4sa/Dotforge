# Small internal helpers (prefixed _df_ so they don't clash with your names).
_df_err()  { printf '\e[0;31m%s\e[0m\n' "$*" >&2; }
_df_warn() { printf '\e[0;33m%s\e[0m\n' "$*" >&2; }
_df_ok()   { printf '\e[0;32m%s\e[0m\n' "$*"; }

# Find a file or directory by walking up from $PWD. Prints the directory.
#   _df_find_up MAINTAINERS   → /home/me/linux
_df_find_up() {
    local dir="$PWD"
    while :; do
        [ -e "$dir/$1" ] && { printf '%s\n' "$dir"; return 0; }
        [ "$dir" = "/" ] || [ -z "$dir" ] && return 1
        dir="$(dirname "$dir")"
    done
}

# Root of a Linux / U-Boot style tree (has Kbuild + MAINTAINERS), or fail.
_df_kernel_root() {
    local dir="$PWD"
    while [ "$dir" != "/" ] && [ -n "$dir" ]; do
        if [ -f "$dir/Kbuild" ] && [ -f "$dir/MAINTAINERS" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    return 1
}


