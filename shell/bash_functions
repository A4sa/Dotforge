# Local IPs per interface (find the NIC on the board's subnet) + public IP.
myip() {
    echo "Local IPs:"
    ip -4 -o addr show scope global 2>/dev/null | awk '{printf "  %-12s %s\n", $2, $4}'
    echo "Public IP:"
    local pub
    if pub=$(curl -s --max-time 3 https://ifconfig.me) && [ -n "$pub" ]; then
        echo "  $pub"
    else
        echo "  (no internet / timeout)"
    fi
}

# Check if a remote host's TCP port is open.  portscan 192.168.1.100 22
portscan() {
    if [ -z "$1" ] || [ -z "$2" ] || [ "$1" = "-h" ]; then
        echo "Usage: portscan <host> <port>"
        echo "  e.g. portscan 192.168.1.100 22"
        return 1
    fi
    # Host/port are passed as arguments, never pasted into the command string.
    # shellcheck disable=SC2016
    if timeout 3 bash -c 'echo > "/dev/tcp/$1/$2"' _ "$1" "$2" 2>/dev/null; then
        echo "OPEN:   $1:$2"
    else
        echo "CLOSED: $1:$2"
        return 1
    fi
}
