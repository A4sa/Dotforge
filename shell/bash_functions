# Show both the local and public IP addresses. Usage: myip 
myip() {
    echo "Local IPs:"
    ip -4 addr show | grep -oP '(?<=inet\s)\d+(\.\d+){3}' \
        | grep -v "^127\." | sed 's/^/  /'
    echo "Public IP:"
    curl -s --max-time 3 https://ifconfig.me && echo || echo "  (no internet / timeout)"
}

# Check if a remote host's port is open and reachable. Usage: portscan <host> <port>
portscan() {
    if [ -z "$1" ] || [ -z "$2" ]; then
        echo "Usage: portscan <host> <port>"
        echo "  e.g. portscan 192.168.1.100 22"
        return 1
    fi
    local host="$1"
    local port="$2"
    if timeout 3 bash -c "echo >/dev/tcp/$host/$port" 2>/dev/null; then
        echo "OPEN:   $host:$port"
    else
        echo "CLOSED: $host:$port"
    fi
}
