# This file gets sourced by ~/.bashrc, which is also read by non-interactive
# shells (scp, rsync, 'ssh host cmd'). Anything printed there breaks them.
[[ $- != *i* ]] && return


# ============================================================================
# DOTFORGE ROOT
# ============================================================================

# Resolve the repo location from this file's own path (works wherever the
# repo is cloned). Exported so functions and tmux can find repo files.
DOTFORGE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFORGE_DIR


# ============================================================================
# PATH — prepend without duplicates
# ============================================================================
# Re-sourcing ~/.bashrc (or nested shells / tmux panes) would otherwise grow
# PATH every time and slow down every command lookup.
_dotforge_path_prepend() {
    [ -d "$1" ] || return 0
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="$1${PATH:+:$PATH}" ;;
    esac
}
_dotforge_path_prepend "$HOME/go/bin"          # go install ...
_dotforge_path_prepend "$HOME/.cargo/bin"      # cargo install ...
_dotforge_path_prepend "$HOME/.local/bin"      # pip install --user, pipx
_dotforge_path_prepend "$HOME/.local/scripts"  # your own one-off tools
export PATH


# ============================================================================
# HISTORY
# ============================================================================

HISTSIZE=50000
HISTFILESIZE=100000
HISTTIMEFORMAT="%Y-%m-%d %H:%M:%S  "

# Ignore commands starting with a space and drop older duplicates.
HISTCONTROL=ignoreboth:erasedups

# Don't clutter history with these frequently-typed short commands.
HISTIGNORE="ls:ll:la:cd:pwd:h:clr:clear:exit:history:bg:fg"

# Append to the history file instead of overwriting it; store multi-line
# commands as one entry.
shopt -s histappend cmdhist

# Write each command to ~/.bash_history as soon as it runs, so a killed
# terminal or crashed SSH session never loses history.
# (Each pane keeps its own up-arrow history; run 'hsync' to pull in commands
# from other panes. Reloading the whole file on every prompt is slow with
# 100k lines and mixes unrelated panes together.)
hsync() { history -a; history -c; history -r; }


# ============================================================================
# SHELL BEHAVIOR
# ============================================================================

if [ -t 0 ]; then
    # Free Ctrl+S / Ctrl+Q from XON/XOFF flow control (Vim uses Ctrl+S to save).
    stty -ixon 2>/dev/null
    # Don't echo ^C when interrupting a command.
    stty -echoctl 2>/dev/null
fi

# Prevent a single stray Ctrl+D from closing the shell (press it twice).
export IGNOREEOF=1

shopt -s checkwinsize   # Update LINES/COLUMNS after each command (tmux resize)
shopt -s cdspell        # Auto-correct minor typos in cd arguments
shopt -s dirspell       # ...and in directory names during completion
shopt -s globstar       # ** matches recursively:  ls drivers/**/*.dts
shopt -s extglob        # Extended globs:          rm !(*.c|*.h)
shopt -s no_empty_cmd_completion

# Completion behaviour (readline).
bind "set completion-ignore-case on"
bind "set show-all-if-ambiguous on"
bind "set colored-stats on"
bind "set mark-symlinked-directories on"

# Up/Down arrows search history by what you've typed so far:
#   type 'make' then Up → previous make commands only.
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'
bind '"\eOA": history-search-backward'
bind '"\eOB": history-search-forward'


# ============================================================================
# EDITOR & PAGER
# ============================================================================

# Vim for git commit messages, crontab -e, visudo, etc.
export EDITOR=vim
export VISUAL=vim

# less: keep colours (-R), quit if one screen (-F), don't clear screen (-X),
# case-insensitive search unless uppercase (-i).
export PAGER=less
export LESS='-RFXi'

# Colorize man pages.
export LESS_TERMCAP_mb=$'\e[1;32m'
export LESS_TERMCAP_md=$'\e[1;32m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_so=$'\e[01;33m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_us=$'\e[1;4;31m'
export MANPAGER='less -s -M +Gg'


# ============================================================================
# COLORS
# ============================================================================

# ls colours (dircolors honours ~/.dircolors if you have one).
if command -v dircolors &>/dev/null; then
    if [ -r "$HOME/.dircolors" ]; then
        eval "$(dircolors -b "$HOME/.dircolors")"
    else
        eval "$(dircolors -b)"
    fi
fi
alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'

# GCC coloured diagnostics (also when output goes through 'tee build.log').
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'


# ============================================================================
# SOURCE DOTFORGE SHELL FILES
# ============================================================================

# bash_aliases — short command aliases (ll, gs, make, ...)
if [ -f "$DOTFORGE_DIR/shell/bash_aliases" ]; then
    source "$DOTFORGE_DIR/shell/bash_aliases"
fi

# bash_functions — shell functions (xc, con, mkidx, kccdb, ...)
if [ -f "$DOTFORGE_DIR/shell/bash_functions" ]; then
    source "$DOTFORGE_DIR/shell/bash_functions"
fi


# ============================================================================
# PROMPT (PS1)
# ============================================================================
#
# FORMAT:
#   user@host:~/path (branch) [arm64] ✗1 $
#                      │         │     │
#                      │         │     └─ exit code of the last command (only if non-zero)
#                      │         └─ ARCH from 'xc' — never build for the wrong target
#                      └─ git branch (or short SHA when detached)
#   The final '$' is green after success, red after failure.
#
# The prompt is built in PROMPT_COMMAND. The exit status is captured FIRST,
# before anything else runs and overwrites $?.

_DF_RESET='\[\e[0m\]'
_DF_GREEN='\[\e[0;32m\]'
_DF_YELLOW='\[\e[0;33m\]'
_DF_BLUE='\[\e[0;34m\]'
_DF_MAGENTA='\[\e[0;35m\]'
_DF_CYAN='\[\e[0;36m\]'
_DF_RED='\[\e[0;31m\]'
_DF_BOLD='\[\e[1m\]'

# Git branch without spawning a subshell for the common 'not a repo' case:
# walk up looking for .git first, and only call git when one exists.
_dotforge_git_branch() {
    local dir="$PWD"
    while [ -n "$dir" ]; do
        [ -e "$dir/.git" ] && break
        dir="${dir%/*}"
    done
    [ -z "$dir" ] && [ ! -e /.git ] && return
    local branch
    branch=$(git symbolic-ref --short -q HEAD 2>/dev/null) \
        || branch=$(git rev-parse --short HEAD 2>/dev/null) \
        || return
    printf ' (%s)' "$branch"
}

# SECURITY: anything that comes from outside (git branch names, $VIRTUAL_ENV,
# $ARCH) must NEVER be pasted into PS1 as text. Bash expands $(...) and `...`
# inside PS1 at display time, and a git branch can legally be named
# '$(some-command)' — cloning such a repo would run that command on every
# prompt. So PS1 only holds REFERENCES (\${_DF_...}); the expansion result is
# not expanded a second time.
_dotforge_prompt() {
    local status=$?                 # MUST be the first line
    history -a                      # persist history after every command

    _DF_VENV="" _DF_BRANCH="" _DF_XC="" _DF_CODE=""
    [ -n "${VIRTUAL_ENV:-}" ] && _DF_VENV="(${VIRTUAL_ENV##*/}) "
    _DF_BRANCH="$(_dotforge_git_branch)"
    [ -n "${ARCH:-}" ] && _DF_XC=" [${ARCH}]"
    local sym
    if [ "$status" -eq 0 ]; then
        sym="${_DF_GREEN}\\\$${_DF_RESET}"
    else
        _DF_CODE=" ✗${status}"
        sym="${_DF_RED}\\\$${_DF_RESET}"
    fi

    PS1="${_DF_MAGENTA}\${_DF_VENV}${_DF_RESET}"
    PS1+="${_DF_CYAN}${_DF_BOLD}\u${_DF_RESET}${_DF_CYAN}@\h${_DF_RESET}:"
    PS1+="${_DF_BLUE}\w${_DF_RESET}${_DF_YELLOW}\${_DF_BRANCH}${_DF_RESET}"
    PS1+="${_DF_MAGENTA}\${_DF_XC}${_DF_RESET}${_DF_RED}\${_DF_CODE}${_DF_RESET} ${sym} "
    return "$status"                # keep $? intact for later PROMPT_COMMAND hooks
}

# Run first, exactly once (guard against re-sourcing ~/.bashrc).
if [[ ";${PROMPT_COMMAND};" != *";_dotforge_prompt;"* ]]; then
    PROMPT_COMMAND="_dotforge_prompt${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi

# Python venv: the prompt shows the venv itself.
export VIRTUAL_ENV_DISABLE_PROMPT=1

# PS2 — shown when a command continues on the next line (after \).
PS2="${_DF_YELLOW}→ ${_DF_RESET}"


# ============================================================================
# TOOL INTEGRATIONS
# ============================================================================

# ── bash-completion (git, make targets, apt, systemctl ...) ──────────────
# Ubuntu's default ~/.bashrc already loads it; load it here otherwise.
if ! declare -F _init_completion &>/dev/null \
   && [ -r /usr/share/bash-completion/bash_completion ]; then
    source /usr/share/bash-completion/bash_completion
fi

# ── fzf — fuzzy finder ────────────────────────────────────────────────────
#   Ctrl+R  fuzzy history     Ctrl+T  insert a file path     Alt+C  cd into dir
if command -v fzf &>/dev/null; then
    # fzf >= 0.48 prints its own integration; older versions ship files.
    if _df_fzf_init=$(fzf --bash 2>/dev/null); then
        eval "$_df_fzf_init"
    else
        [ -f /usr/share/doc/fzf/examples/key-bindings.bash ] && \
            source /usr/share/doc/fzf/examples/key-bindings.bash
        [ -f /usr/share/bash-completion/completions/fzf ] && \
            source /usr/share/bash-completion/completions/fzf
    fi
    unset _df_fzf_init

    # fzf appearance — match gruvbox color scheme
    export FZF_DEFAULT_OPTS="
        --height 40%
        --layout=reverse
        --border
        --color=bg+:#3c3836,bg:#282828,spinner:#fb4934,hl:#928374
        --color=fg:#ebdbb2,header:#928374,info:#8ec07c,pointer:#fb4934
        --color=marker:#fb4934,fg+:#ebdbb2,prompt:#fb4934,hl+:#fb4934"

    # Use ripgrep as the file source if available (respects .gitignore,
    # skips build output — much faster than find in a kernel tree).
    if command -v rg &>/dev/null; then
        export FZF_DEFAULT_COMMAND='rg --files --hidden --follow --glob "!.git"'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    fi
fi

# ── zoxide — smarter cd with frecency ────────────────────────────────────
#   z kernel     → jumps to your most-visited kernel directory
#   z cv25 dts   → matches multiple path fragments
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init bash)"
fi

# ── direnv — per-directory environment ───────────────────────────────────
#   Put 'export ARCH=arm64 CROSS_COMPILE=aarch64-linux-gnu-' in a board
#   tree's .envrc and the toolchain switches automatically when you cd in.
if command -v direnv &>/dev/null; then
    eval "$(direnv hook bash)"
fi


# ============================================================================
# AUTO-START TMUX (opt-in)
# ============================================================================
# Uncomment to start or attach to a tmux session when a terminal opens.
# Not done over SSH-from-scripts because of the interactive guard above.

# if command -v tmux &>/dev/null && [ -z "$TMUX" ] && [ -z "$INSIDE_EMACS" ]; then
#    exec tmux new-session -A -s forge
# fi


# ============================================================================
# MACHINE-LOCAL CONFIG — loaded last so it can override anything above
# ============================================================================
# Project paths, board aliases, default toolchain. Not in the repo.
if [ -f "$HOME/.bash_local" ]; then
    source "$HOME/.bash_local"
fi
