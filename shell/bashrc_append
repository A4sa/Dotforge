#
#
#  WHAT THIS FILE DOES
#  -------------------
#  1. Loads bash_aliases     — short command aliases
#  2. Loads bash_functions   — shell functions (xc, dlog, adbpush, etc.)
#  3. Loads bash_local       — your private machine-specific paths (not in repo)
#  4. Configures the prompt  — clean PS1 with git branch + exit code
#  5. Sets developer env     — history, colors, editor, terminal behavior
#  6. Tool integrations      — fzf, direnv, nvm (if installed)
#
# ============================================================================


# This file gets sourced by ~/.bashrc which itself can be called by non-interactive shells (scripts, SSH commands, cron jobs).
[[ $- != *i* ]] && return


# ============================================================================
# DOTFORGE ROOT
# ============================================================================

# Resolve the dotforge repo location dynamically.
DOTFORGE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"


# ============================================================================
# SOURCE DOTFORGE SHELL FILES
# ============================================================================

# bash_aliases — short command aliases (ll, gs, make, con, etc.)
if [ -f "$DOTFORGE_DIR/shell/bash_aliases" ]; then
    source "$DOTFORGE_DIR/shell/bash_aliases"
fi

# bash_functions — shell functions (xc, dlog, adbpush, kgrep, etc.)
if [ -f "$DOTFORGE_DIR/shell/bash_functions" ]; then
    source "$DOTFORGE_DIR/shell/bash_functions"
fi

# bash_local — your private machine-specific config (NOT in the repo)
if [ -f "$HOME/.bash_local" ]; then
    source "$HOME/.bash_local"
fi


# ============================================================================
# PROMPT (PS1)
# ============================================================================
#
# FORMAT:
#   user@host:~/path [branch] $
#   └── green if last command succeeded, red if it failed
#
#

# Helper: get current git branch
_git_branch() {
    local branch
    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    [ -n "$branch" ] && echo " ($branch)"
}

# Colors
_RESET='\[\033[0m\]'
_GREEN='\[\033[0;32m\]'
_YELLOW='\[\033[0;33m\]'
_BLUE='\[\033[0;34m\]'
_CYAN='\[\033[0;36m\]'
_RED='\[\033[0;31m\]'
_BOLD='\[\033[1m\]'

# PS1 — the prompt shown before every command.
PS1="${_CYAN}${_BOLD}\u${_RESET}${_CYAN}@\h${_RESET}:${_BLUE}\w${_RESET}${_YELLOW}\$(_git_branch)${_RESET} \$([ \$? -eq 0 ] && echo '${_GREEN}\$${_RESET}' || echo '${_RED}\$${_RESET}') "

# PS2 — shown when a command continues on the next line (after \).
PS2="${_YELLOW}→ ${_RESET}"


# ============================================================================
# HISTORY
# ============================================================================

# Store 10,000 lines in memory and 20,000 lines on disk.
HISTSIZE=10000
HISTFILESIZE=20000

# Add timestamps to history entries.
HISTTIMEFORMAT="%Y-%m-%d %H:%M:%S  "

# Append to history file, don't overwrite it.
shopt -s histappend

# Helper: Sync history while preserving the exit code ($?) of the last command
_dotforge_sync_history() {
    local exit_status=$?
    history -a
    history -c
    history -r
    return $exit_status
}

# Save history after every command, not just on exit.
if [[ ";$PROMPT_COMMAND;" != *";_dotforge_sync_history;"* ]]; then
    PROMPT_COMMAND="_dotforge_sync_history; $PROMPT_COMMAND"
fi

# Don't save duplicate commands or commands starting with a space.
HISTCONTROL=ignoreboth

# Don't clutter history with these frequently-typed short commands.
HISTIGNORE="ls:ll:la:cd:pwd:h:clr:clear:exit:history:bg:fg"


# ============================================================================
# SHELL BEHAVIOR
# ============================================================================

# Fix the terminal so Ctrl+S doesn't freeze it (XON/XOFF flow control).
stty -ixon

# Prevent Ctrl+D from accidentally exiting the shell.
export IGNOREEOF=1

# Fix escape sequence display in terminal.
stty -echoctl

# Auto-correct minor typos in cd commands.
shopt -s cdspell

# Allow ** glob pattern to match recursively across directories.
shopt -s globstar

# Case-insensitive tab completion.
bind "set completion-ignore-case on"

# Tab completion shows all matches immediately (no double-tab needed).
bind "set show-all-if-ambiguous on"

# ============================================================================
# EDITOR & PAGER
# ============================================================================

# Set Vim as the default editor for git commit messages, crontan.
export EDITOR=vim
export VISUAL=vim

# Set less as the default pager with useful flags.
export PAGER='less -RFX'
export LESS='-RFX'

# WHAT: Colorize man pages.
export LESS_TERMCAP_mb=$'\e[1;32m'
export LESS_TERMCAP_md=$'\e[1;32m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_so=$'\e[01;33m'
export LESS_TERMCAP_ue=$'\e[0m'
export LESS_TERMCAP_us=$'\e[1;4;31m'


# ============================================================================
# COLORS
# ============================================================================

# Enable colors in ls, grep, and diff output.
export CLICOLOR=1
export GREP_OPTIONS='--color=auto'
alias grep='grep --color=auto'
alias diff='diff --color=auto'

# Enable GCC colored output (available since GCC 4.9).
export GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'


# ============================================================================
# PATH
# ============================================================================

# Python user packages (pip install --user)
export PATH="$HOME/.local/bin:$PATH"

# Go binaries (go install ...)
[ -d "$HOME/go/bin" ] && export PATH="$HOME/go/bin:$PATH"

# Local scripts — your own tools and one-off scripts
[ -d "$HOME/.local/scripts" ] && export PATH="$HOME/.local/scripts:$PATH"



# ============================================================================
# TOOL INTEGRATIONS
# ============================================================================

# ── fzf — fuzzy finder ────────────────────────────────────────────────────
if command -v fzf &>/dev/null; then
    # Ubuntu apt install puts these here
    [ -f /usr/share/doc/fzf/examples/key-bindings.bash ] && \
        source /usr/share/doc/fzf/examples/key-bindings.bash
    [ -f /usr/share/bash-completion/completions/fzf ] && \
        source /usr/share/bash-completion/completions/fzf

    # fzf appearance — match gruvbox color scheme
    export FZF_DEFAULT_OPTS="
        --height 40%
        --layout=reverse
        --border
        --color=bg+:#3c3836,bg:#282828,spinner:#fb4934,hl:#928374
        --color=fg:#ebdbb2,header:#928374,info:#8ec07c,pointer:#fb4934
        --color=marker:#fb4934,fg+:#ebdbb2,prompt:#fb4934,hl+:#fb4934"

    # Use ripgrep as the fzf file source if available (much faster than find)
    if command -v rg &>/dev/null; then
        export FZF_DEFAULT_COMMAND='rg --files --hidden --follow --glob "!.git"'
        export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    fi
fi


# ── zoxide — smarter cd with frecency ────────────────────────────────────
#
# USAGE:    z kernel    → jumps to your most-visited kernel directory
#           z cv25 dts  → matches multiple path fragments
if command -v zoxide &>/dev/null; then
    eval "$(zoxide init bash)"
fi
