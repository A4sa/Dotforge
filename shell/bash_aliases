# ======================= NAVIGATION & SHELL BASICS =======================
alias clr='clear'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias h='history'           # Example h | grep make
alias o='xdg-open'          # Open files/URLs in default apps

# ====================== SYSTEM & PACKAGE MANAGEMENT ======================
alias update='sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y'
alias install='sudo apt install'
alias remove='sudo apt remove -y'
alias reboot='sudo reboot'
alias dmesg='sudo dmesg'

# ========================= FILE LISTING & SEARCH =========================
alias ll='ls -alF'          
alias la='ls -A'
alias ls='ls --color=auto'

# ========================= FUZZY FINDER (fzf) ==========================
alias f='fzf'
alias ff='fzf --preview="bat --style=numbers --color=always {}"'
alias vfind='vim $(fzf)' # Open file in vim

# ============================= Git =====================================
alias g='git'
alias gs='git status'
alias ga='git add'
alias gc='git commit -m'
alias gl='git log'
alias gb='git branch'
alias gco='git checkout'
alias gd='git diff'
alias gpl='git pull'
alias gps='git push'

# ================== PYTHON & VIRTUAL ENVIRONMENTS ===================
alias python='python3'
alias py='python3'
alias pip='pip3'
alias va='source venv/bin/activate'
alias envd='deactivate'

# ============================== DOCKER ==============================
alias docker='sudo docker'
alias dkps='docker ps'                   # List running containers
alias dkpsa='docker ps -a'               # List all containers (including stopped)
alias dkimg='docker images'              # List local images
alias dkrm='docker rm'                   # Remove a container
alias dkrmi='docker rmi'                 # Remove an image
alias dklog='docker logs'                # Show container stdout/stderr logs
alias dkexec='docker exec -it'           # Enter a running container interactively
alias dkstop='docker stop'               # Stop a running container
alias dkprune='docker system prune -f'   # Remove all stopped containers 

# ========================== BUILD SYSTEM =============================
alias make='make -j$(nproc)'             
alias mb='make -j$(nproc)'              # Multi-core parallel build i
alias mc='make clean'                   # Clean build artifacts 
alias mdtb='make -j$(nproc) dtbs'       # make the DTB
alias mbmod='make -j$(nproc) modules'   # make the Driver .ko
alias mkcs='find . -name "*.[ch]" > cscope.files && cscope -b -q -k && echo "cscope index rebuilt"'
alias mktags='ctags -R --exclude=.git --exclude="*.o" --exclude="*.ko" . && echo "ctags index rebuilt"'
alias mkidx='mkcs && mktags'            # Rebuild both at once

# ================== ANDROID DEBUG BRIDGE (ADB) ======================
alias shell='adb shell' 
alias adbdev='adb devices'               # List connected devices
alias adblog='adb logcat'                # Stream Android logcat output
alias adbr='adb reboot'                  # Reboot the target device

# ===================== SERIAL CONSOLE ================================

# ── picocom aliases ───────────────────────────────────────────────────
alias con='picocom -b 115200 --flow=none /dev/ttyUSB0'

alias con0='picocom -b 115200 --flow=none /dev/ttyUSB0'
alias con1='picocom -b 115200 --flow=none /dev/ttyUSB1'
alias con2='picocom -b 115200 --flow=none /dev/ttyACM0'

alias con57='picocom -b 57600 --flow=none /dev/ttyUSB0'
alias con9='picocom  -b 9600  --flow=none /dev/ttyUSB0'

# TIP:  Review the log later with: cat ~/serial_logs/<file> | less
alias conlog='mkdir -p ~/serial_logs && picocom -b 115200 --flow=none \
    --logfile ~/serial_logs/$(date +%Y-%m-%d_%H-%M-%S).log /dev/ttyUSB0'

# ── minicom aliases ────────────────────────────────────────────────────
alias mcom='minicom'

alias mcom-setup='sudo minicom -s'

alias mcom0='minicom -D /dev/ttyUSB0 -b 115200'
alias mcom1='minicom -D /dev/ttyUSB1 -b 115200'

alias mcom-xfer='minicom -D /dev/ttyUSB0 -b 115200 -c on'

alias lsserial='echo "=== by-id (stable) ===" && \
    ls /dev/serial/by-id/ 2>/dev/null || echo "none" && \
    echo "=== raw devices ===" && \
    ls /dev/ttyUSB* /dev/ttyACM* 2>/dev/null || echo "none"'

# =====================  KERNEL / BSP HELPERS ===========================
alias kconfig='make menuconfig'            # Open Kernel config menu

# Note: kgrep, modcheck, and dlog are defined with proper validation in bash_functions

alias buildlog='tail -50 build.log'
alias buildlogerr='grep -E "error:|warning:" build.log | tail -30'


