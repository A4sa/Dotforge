# ======================= NAVIGATION & SHELL BASICS =======================
alias clr='clear'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias ~='cd ~'
alias -- -='cd -'
# Example: h | grep make
alias h='history'
# Open files/URLs in the default desktop app
alias o='xdg-open'

# ====================== SYSTEM & PACKAGE MANAGEMENT ======================
if command -v apt &>/dev/null; then
    alias update='sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y'
    # NOT named 'install'/'remove': 'install' is a coreutils command that
    # Makefiles and scripts you run by hand call (install -m755 ...).
    alias apti='sudo apt install'
    alias aptr='sudo apt remove'
fi
# Kernel ring buffer. dmesg_restrict=1 on Ubuntu needs sudo.
#   dmesg   — whole buffer        dmw — follow new messages (like tail -f)
alias dmesg='sudo dmesg'
alias dmw='sudo dmesg -w'
# Human-readable disk usage / free space
alias df='df -h'
alias du1='du -h --max-depth=1 | sort -h'
alias free='free -h'

# ========================= FILE LISTING & SEARCH =========================
alias ls='ls --color=auto'
alias ll='ls -alFh'
alias la='ls -A'
alias lt='ls -alFht'                      # newest first — "what did the build just produce?"

# Ubuntu/Debian ship bat as 'batcat'.
if ! command -v bat &>/dev/null && command -v batcat &>/dev/null; then
    alias bat='batcat'
fi

# ========================= FUZZY FINDER (fzf) ==========================
alias f='fzf'
# vf (open the picked file in vim) and ff (preview) are functions.

# ============================= Git =====================================
alias g='git'
alias gs='git status'
alias ga='git add'
alias gap='git add -p'
alias gc='git commit -m'
alias gca='git commit --amend --no-edit'
alias gl='git log'
alias glg='git log --oneline --graph --decorate --all'
alias gb='git branch'
alias gco='git checkout'
alias gsw='git switch'
alias gd='git diff'
alias gds='git diff --staged'
alias gpl='git pull'
alias gps='git push'
# Kernel-style patch workflow
alias gfp='git format-patch'
alias gsob='git commit -s'                # commit with Signed-off-by

# ================== PYTHON & VIRTUAL ENVIRONMENTS ===================
alias python='python3'
alias py='python3'
# 'python3 -m pip' always matches the active interpreter / venv.
alias pip='python3 -m pip'
alias envd='deactivate'
# va (activate ./venv or ./.venv) is a function.

# ============================== DOCKER ==============================
# No 'sudo' here: add yourself to the docker group (see top of file).
# sudo docker makes files in bind-mounted build dirs root-owned.
alias dkps='docker ps'                   # List running containers
alias dkpsa='docker ps -a'               # List all containers (including stopped)
alias dkimg='docker images'              # List local images
alias dkrm='docker rm'                   # Remove a container
alias dkrmi='docker rmi'                 # Remove an image
alias dklog='docker logs -f'             # Follow container stdout/stderr logs
alias dkexec='docker exec -it'           # Enter a running container interactively
alias dkstop='docker stop'               # Stop a running container
alias dkprune='docker system prune -f'   # Remove stopped containers, dangling images
# Run a throw-away container with the current dir mounted, as YOU (not root):
#   dkrun ubuntu:22.04 bash
alias dkrun='docker run --rm -it -u "$(id -u):$(id -g)" -v "$PWD":"$PWD" -w "$PWD"'

# ========================== BUILD SYSTEM =============================
# Interactive 'make' is always parallel. Aliases never affect scripts.
# Use '\make' for a serial build (readable error output).
alias make='make -j$(nproc)'
alias mb='make -j$(nproc)'               # Multi-core parallel build
alias mc='make clean'                    # Clean build artifacts
alias mdtb='make -j$(nproc) dtbs'        # Build all device tree blobs
alias mbmod='make -j$(nproc) modules'    # Build kernel modules (.ko)
alias kconfig='make menuconfig'          # Kernel/U-Boot/Buildroot config menu
alias ksave='make savedefconfig'         # Minimal defconfig from .config
# mkl (make + build.log), mkcs/mktags/mkidx (indexes) are functions.
alias buildlog='less +G build.log'
alias buildlogerr='grep -nE "error:|warning:|undefined reference" build.log | tail -40'

# ================== ANDROID DEBUG BRIDGE (ADB) ======================
alias shell='adb shell'
alias adbdev='adb devices -l'            # List connected devices (with model)
alias adblog='adb logcat -v threadtime'  # Stream logcat with thread + time
alias adbr='adb reboot'                  # Reboot the target device
alias adbroot='adb root && adb wait-for-device && adb remount'

# ===================== SERIAL CONSOLE ================================
# 'con' is a function:  con [device|index] [baud] [-l]   (see bash_functions)
# These keep the old short names working.
alias con0='con /dev/ttyUSB0'
alias con1='con /dev/ttyUSB1'
alias con2='con /dev/ttyACM0'
alias con57='con /dev/ttyUSB0 57600'
alias con9='con /dev/ttyUSB0 9600'
alias conlog='con /dev/ttyUSB0 115200 -l'

# minicom — for XMODEM/YMODEM transfers to a bootloader (Ctrl+A S to send).
alias mcom='minicom -c on'
alias mcom-setup='sudo minicom -s'
alias mcom0='minicom -c on -D /dev/ttyUSB0 -b 115200'
alias mcom1='minicom -c on -D /dev/ttyUSB1 -b 115200'

# ========================= SSH from inside tmux ======================
# tmux sets TERM=tmux-256color, which BusyBox/Buildroot targets usually
# don't know ('unknown terminal type' in vi/less/top). Present a common one.
if [ -n "$TMUX" ]; then
    alias ssh='TERM=xterm-256color ssh'
fi
