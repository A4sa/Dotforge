#  ██║         ╚════██║██║╚██╗██║██║██╔═══╝ ██╔═══╝ ██╔══╝     ██║   ╚════██║
#  ╚██████╗    ███████║██║ ╚████║██║██║     ██║     ███████╗   ██║   ███████║
#   ╚═════╝    ╚══════╝╚═╝  ╚═══╝╚═╝╚═╝     ╚═╝     ╚══════╝   ╚═╝   ╚══════╝
#
#  File name   : c.snippets
#  Author      : Abdul Sattar <abdul.linuxdev@gmail.com>
#  Repository  : https://github.com/A4sa/dotforge.git
#  Description : UltiSnips snippets for embedded C and Linux kernel development.
#
#  KERNEL VERSION
#  --------------
#  Driver snippets target the CURRENT kernel API (v6.11 and newer):
#    - platform/i2c/spi .remove return void           (6.11 / 6.1 / 5.18)
#    - i2c .probe takes only the client               (6.3)
#    - class_create() takes only the name             (6.4)
#    - devm_clk_get_enabled()                         (6.3)
#  For an older vendor kernel, adjust those lines.
#
#  AUTHOR NAME / EMAIL
#  -------------------
#  Filled in from 'git config user.name' / 'user.email', so the snippets
#  carry YOUR name in MODULE_AUTHOR, not the dotforge author's.
#
#  HOW ULTISNIPS WORKS
#  -------------------
#  1. Type the trigger word in INSERT mode
#  2. Press Tab  → expands the snippet
#  3. Press Tab  → jump to next placeholder  ($1, $2 ...)
#  4. Press S-Tab → jump to previous placeholder
#  :UltiSnipsEdit opens this file for the current filetype.
#
#  INSTALLED AT: ~/.vim/UltiSnips/c.snippets (symlink to the repo, install.sh)
#
#  TABLE OF CONTENTS
#  -----------------
#  [1]  File Header
#  [2]  Header Guards
#  [3]  Kernel Module Skeleton   (Makefile: see make.snippets → kmod_make)
#  [4]  Platform Driver
#  [5]  I2C Driver
#  [6]  SPI Driver
#  [7]  Interrupt Handler
#  [8]  Device Tree Nodes
#  [9]  Debug & Logging
#  [10] Common Kernel Patterns
#  [11] Memory Management / DMA
#  [12] Miscellaneous C Patterns
#
# ============================================================================

# Author helpers — read once from git config.
global !p
import re
import subprocess
def git_cfg(key, default):
	try:
		out = subprocess.run(['git', 'config', key], capture_output=True, text=True, timeout=2).stdout.strip()
		return out or default
	except Exception:
		return default
def author():
	return git_cfg('user.name', 'Your Name')
def email():
	return git_cfg('user.email', 'you@example.com')
endglobal


# ============================================================================
# [1]  FILE HEADER
# ============================================================================

# trigger: fhdr
# SPDX header. .c files use '//' for the SPDX line, headers use '/* */'
# (Documentation/process/license-rules.rst).
snippet fhdr "File header for kernel/BSP source files" b
`!p snip.rv = '// SPDX-License-Identifier: ' if snip.fn.endswith('.c') else '/* SPDX-License-Identifier: '`${1:GPL-2.0-only}`!p snip.rv = '' if snip.fn.endswith('.c') else ' */'`
/*
 * ${2:Brief description of this file}
 *
 * Copyright (C) `!v strftime('%Y')` ${3:`!p snip.rv = author()`} <${4:`!p snip.rv = email()`}>
 */
$0
endsnippet


# ============================================================================
# [2]  HEADER GUARDS
# ============================================================================

# trigger: hguard
# Header guard from the file name: foo-bar.h → __FOO_BAR_H
snippet hguard "Header file guard (#ifndef)" b
#ifndef ${1:`!p snip.rv = '__' + re.sub(r'[^A-Za-z0-9]', '_', snip.basename or 'HEADER').upper() + '_H'`}
#define $1

$0

#endif /* $1 */
endsnippet

# trigger: hguardcpp
# Header guard with extern "C" — for userspace headers shared with C++.
snippet hguardcpp "Header guard with extern C (userspace)" b
#ifndef ${1:`!p snip.rv = re.sub(r'[^A-Za-z0-9]', '_', snip.basename or 'HEADER').upper() + '_H'`}
#define $1

#ifdef __cplusplus
extern "C" {
#endif

$0

#ifdef __cplusplus
}
#endif

#endif /* $1 */
endsnippet

# trigger: once
# Pragma once (non-standard but widely supported; not used in the kernel)
snippet once "Pragma once header guard" b
#pragma once

$0
endsnippet


# ============================================================================
# [3]  KERNEL MODULE SKELETON
# ============================================================================

# trigger: kmod
# Minimal kernel module — compiles and loads out of the box.
# pr_fmt prefixes every pr_*() message with the module name.
snippet kmod "Minimal kernel module skeleton" b
// SPDX-License-Identifier: GPL-2.0-only
/*
 * ${2:Module description}
 *
 * Copyright (C) `!v strftime('%Y')` ${3:`!p snip.rv = author()`} <${4:`!p snip.rv = email()`}>
 */

#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt

#include <linux/init.h>
#include <linux/module.h>

static int __init ${1:`!p snip.rv = re.sub(r'[^A-Za-z0-9_]', '_', snip.basename or 'driver_name')`}_init(void)
{
	pr_info("loaded\n");
	return 0;
}

static void __exit $1_exit(void)
{
	pr_info("unloaded\n");
}

module_init($1_init);
module_exit($1_exit);

MODULE_AUTHOR("$3 <$4>");
MODULE_DESCRIPTION("$2");
MODULE_LICENSE("GPL");
$0
endsnippet



# ============================================================================
# [4]  PLATFORM DRIVER
# ============================================================================

# trigger: platdrv
# platform_driver with MMIO, clock, reset and IRQ — all devm-managed, so
# teardown happens in exact reverse order of probe (IRQ is freed BEFORE the
# clock is gated; the handler can never touch an unclocked block).
snippet platdrv "Linux platform driver skeleton" b
// SPDX-License-Identifier: GPL-2.0-only
/*
 * ${2:Platform driver for X peripheral}
 *
 * Copyright (C) `!v strftime('%Y')` ${3:`!p snip.rv = author()`} <${4:`!p snip.rv = email()`}>
 */

#include <linux/clk.h>
#include <linux/delay.h>
#include <linux/interrupt.h>
#include <linux/io.h>
#include <linux/mod_devicetable.h>
#include <linux/module.h>
#include <linux/platform_device.h>
#include <linux/reset.h>

struct ${1:`!p snip.rv = re.sub(r'[^A-Za-z0-9_]', '_', snip.basename or 'driver_name')`}_priv {
	struct device *dev;
	void __iomem *base;		/* MMIO base address */
	struct clk *clk;		/* peripheral clock */
	struct reset_control *rst;	/* optional reset line */
	int irq;
};

static irqreturn_t $1_irq_handler(int irq, void *dev_id)
{
	struct $1_priv *priv = dev_id;

	/* TODO: read the status register; return IRQ_NONE if it is not ours */
	/* TODO: clear the interrupt at the hardware level */
	(void)priv;

	return IRQ_HANDLED;
}

static int $1_probe(struct platform_device *pdev)
{
	struct device *dev = &pdev->dev;
	struct $1_priv *priv;
	int ret;

	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
	if (!priv)
		return -ENOMEM;
	priv->dev = dev;

	priv->base = devm_platform_ioremap_resource(pdev, 0);
	if (IS_ERR(priv->base))
		return PTR_ERR(priv->base);

	/* Clock: enabled now, disabled automatically on unbind / probe failure */
	priv->clk = devm_clk_get_enabled(dev, NULL);
	if (IS_ERR(priv->clk))
		return dev_err_probe(dev, PTR_ERR(priv->clk), "failed to get clock\n");

	/* Optional reset: pulse it so the IP starts from a known state.
	 * (assert/deassert works on every reset controller; _reset() does not) */
	priv->rst = devm_reset_control_get_optional_exclusive(dev, NULL);
	if (IS_ERR(priv->rst))
		return dev_err_probe(dev, PTR_ERR(priv->rst), "failed to get reset\n");
	reset_control_assert(priv->rst);
	usleep_range(10, 20);
	ret = reset_control_deassert(priv->rst);
	if (ret)
		return dev_err_probe(dev, ret, "failed to release reset\n");

	priv->irq = platform_get_irq(pdev, 0);
	if (priv->irq < 0)
		return priv->irq;

	/* Trigger type comes from the DT 'interrupts' property — pass 0 here */
	ret = devm_request_irq(dev, priv->irq, $1_irq_handler, 0,
			       dev_name(dev), priv);
	if (ret)
		return dev_err_probe(dev, ret, "failed to request IRQ %d\n", priv->irq);

	platform_set_drvdata(pdev, priv);
	dev_dbg(dev, "probed\n");
	return 0;
}

static void $1_remove(struct platform_device *pdev)
{
	/* devm undoes probe in reverse order: IRQ, reset, clock, MMIO */
	dev_dbg(&pdev->dev, "removed\n");
}

static const struct of_device_id $1_of_match[] = {
	{ .compatible = "${5:vendor,device}" },
	{ /* sentinel */ }
};
MODULE_DEVICE_TABLE(of, $1_of_match);

static struct platform_driver $1_driver = {
	.probe  = $1_probe,
	.remove = $1_remove,
	.driver = {
		.name           = "$1",
		.of_match_table = $1_of_match,
	},
};
module_platform_driver($1_driver);

MODULE_AUTHOR("$3 <$4>");
MODULE_DESCRIPTION("$2");
MODULE_LICENSE("GPL");
$0
endsnippet


# ============================================================================
# [5]  I2C DRIVER
# ============================================================================

# trigger: i2cdrv
# i2c_driver with regmap, optional supply regulator and reset GPIO —
# the usual power-on sequence for a sensor/PMIC/codec.
snippet i2cdrv "Linux I2C driver skeleton" b
// SPDX-License-Identifier: GPL-2.0-only
/*
 * ${2:I2C driver for X sensor/device}
 *
 * Copyright (C) `!v strftime('%Y')` ${3:`!p snip.rv = author()`} <${4:`!p snip.rv = email()`}>
 */

#include <linux/delay.h>
#include <linux/gpio/consumer.h>
#include <linux/i2c.h>
#include <linux/mod_devicetable.h>
#include <linux/module.h>
#include <linux/regmap.h>
#include <linux/regulator/consumer.h>

/* Register map */
#define ${5:REG_CHIP_ID}		0x00
#define ${6:REG_CTRL}		0x01

struct ${1:`!p snip.rv = re.sub(r'[^A-Za-z0-9_]', '_', snip.basename or 'driver_name')`}_priv {
	struct device *dev;
	struct i2c_client *client;
	struct regmap *regmap;
	struct gpio_desc *reset_gpio;
};

static const struct regmap_config $1_regmap_config = {
	.reg_bits     = 8,
	.val_bits     = 8,
	.max_register = 0xff,
};

static int $1_probe(struct i2c_client *client)
{
	struct device *dev = &client->dev;
	struct $1_priv *priv;
	unsigned int id;
	int ret;

	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
	if (!priv)
		return -ENOMEM;
	priv->dev = dev;
	priv->client = client;

	/* Power: enabled now, disabled automatically on unbind */
	ret = devm_regulator_get_enable_optional(dev, "vdd");
	if (ret && ret != -ENODEV)
		return dev_err_probe(dev, ret, "failed to enable vdd\n");

	/* Optional active-low reset line: assert, wait, release */
	priv->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
	if (IS_ERR(priv->reset_gpio))
		return dev_err_probe(dev, PTR_ERR(priv->reset_gpio), "failed to get reset GPIO\n");
	if (priv->reset_gpio) {
		usleep_range(1000, 2000);
		gpiod_set_value_cansleep(priv->reset_gpio, 0);
		usleep_range(${7:5000}, ${8:10000});	/* datasheet power-up time */
	}

	priv->regmap = devm_regmap_init_i2c(client, &$1_regmap_config);
	if (IS_ERR(priv->regmap))
		return dev_err_probe(dev, PTR_ERR(priv->regmap), "failed to init regmap\n");

	/* Talk to the chip once: a wrong address / missing pull-ups fails here */
	ret = regmap_read(priv->regmap, $5, &id);
	if (ret)
		return dev_err_probe(dev, ret, "no response at 0x%02x\n", client->addr);

	i2c_set_clientdata(client, priv);
	dev_info(dev, "chip id 0x%02x at 0x%02x\n", id, client->addr);
	return 0;
}

static void $1_remove(struct i2c_client *client)
{
	dev_dbg(&client->dev, "removed\n");
}

static const struct i2c_device_id $1_id[] = {
	{ "$1" },
	{ }
};
MODULE_DEVICE_TABLE(i2c, $1_id);

static const struct of_device_id $1_of_match[] = {
	{ .compatible = "${9:vendor,device}" },
	{ }
};
MODULE_DEVICE_TABLE(of, $1_of_match);

static struct i2c_driver $1_driver = {
	.driver = {
		.name           = "$1",
		.of_match_table = $1_of_match,
	},
	.probe    = $1_probe,
	.remove   = $1_remove,
	.id_table = $1_id,
};
module_i2c_driver($1_driver);

MODULE_AUTHOR("$3 <$4>");
MODULE_DESCRIPTION("$2");
MODULE_LICENSE("GPL");
$0
endsnippet


# ============================================================================
# [6]  SPI DRIVER
# ============================================================================

# trigger: spidrv
# spi_driver. SPI mode (CPOL/CPHA), CS polarity and max frequency come from
# the DT node (spi-cpol, spi-cpha, spi-cs-high, spi-max-frequency) — the
# driver must not overwrite spi->mode, or it clobbers those DT flags.
snippet spidrv "Linux SPI driver skeleton" b
// SPDX-License-Identifier: GPL-2.0-only
/*
 * ${2:SPI driver for X device}
 *
 * Copyright (C) `!v strftime('%Y')` ${3:`!p snip.rv = author()`} <${4:`!p snip.rv = email()`}>
 */

#include <linux/mod_devicetable.h>
#include <linux/module.h>
#include <linux/regmap.h>
#include <linux/spi/spi.h>

struct ${1:`!p snip.rv = re.sub(r'[^A-Za-z0-9_]', '_', snip.basename or 'driver_name')`}_priv {
	struct device *dev;
	struct spi_device *spi;
	struct regmap *regmap;
};

static const struct regmap_config $1_regmap_config = {
	.reg_bits     = 8,
	.val_bits     = 8,
	.max_register = 0x7f,
	.read_flag_mask = 0x80,		/* common: MSB=1 means read — check datasheet */
};

static int $1_probe(struct spi_device *spi)
{
	struct device *dev = &spi->dev;
	struct $1_priv *priv;
	int ret;

	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
	if (!priv)
		return -ENOMEM;
	priv->dev = dev;
	priv->spi = spi;

	/* Only set what DT can't describe; keep DT mode flags intact */
	spi->bits_per_word = ${5:8};
	ret = spi_setup(spi);
	if (ret)
		return dev_err_probe(dev, ret, "spi_setup failed\n");

	priv->regmap = devm_regmap_init_spi(spi, &$1_regmap_config);
	if (IS_ERR(priv->regmap))
		return dev_err_probe(dev, PTR_ERR(priv->regmap), "failed to init regmap\n");

	spi_set_drvdata(spi, priv);
	dev_info(dev, "probed (mode %u, %u Hz)\n",
		 (unsigned int)(spi->mode & SPI_MODE_X_MASK), spi->max_speed_hz);
	return 0;
}

static void $1_remove(struct spi_device *spi)
{
	dev_dbg(&spi->dev, "removed\n");
}

static const struct of_device_id $1_of_match[] = {
	{ .compatible = "${6:vendor,device}" },
	{ }
};
MODULE_DEVICE_TABLE(of, $1_of_match);

static const struct spi_device_id $1_id[] = {
	{ "$1" },
	{ }
};
MODULE_DEVICE_TABLE(spi, $1_id);

static struct spi_driver $1_driver = {
	.driver = {
		.name           = "$1",
		.of_match_table = $1_of_match,
	},
	.probe    = $1_probe,
	.remove   = $1_remove,
	.id_table = $1_id,
};
module_spi_driver($1_driver);

MODULE_AUTHOR("$3 <$4>");
MODULE_DESCRIPTION("$2");
MODULE_LICENSE("GPL");
$0
endsnippet


# ============================================================================
# [7]  INTERRUPT HANDLER
# ============================================================================

# trigger: irqh
# Hard IRQ handler (MMIO devices — fast, cannot sleep).
# Flags 0: the trigger type (edge/level, polarity) comes from DT.
snippet irqh "IRQ request + handler skeleton" b
static irqreturn_t ${1:driver}_irq_handler(int irq, void *dev_id)
{
	struct $1_priv *priv = dev_id;
	u32 status;

	status = readl(priv->base + ${2:REG_IRQ_STATUS});
	if (!status)
		return IRQ_NONE;		/* shared line: not ours */

	writel(status, priv->base + $2);	/* ack (write-1-to-clear) */
	/* TODO: handle 'status' bits / complete() / wake_up() */

	return IRQ_HANDLED;
}

/* In probe(): */
ret = devm_request_irq(dev, priv->irq, $1_irq_handler, 0, dev_name(dev), priv);
if (ret)
	return dev_err_probe(dev, ret, "failed to request IRQ %d\n", priv->irq);
$0
endsnippet

# trigger: irqth
# Threaded IRQ for devices behind I2C/SPI (the handler must sleep to talk to
# the chip). NULL primary handler + IRQF_ONESHOT keeps the line masked until
# the thread has cleared the source — without ONESHOT a level-triggered IRQ
# (most sensors/PMICs) storms and locks up the CPU.
snippet irqth "Threaded IRQ handler (I2C/SPI devices)" b
static irqreturn_t ${1:driver}_irq_thread(int irq, void *dev_id)
{
	struct $1_priv *priv = dev_id;
	unsigned int status;
	int ret;

	/* Safe to sleep here — regmap over I2C/SPI */
	ret = regmap_read(priv->regmap, ${2:REG_IRQ_STATUS}, &status);
	if (ret || !status)
		return IRQ_NONE;

	/* TODO: handle and clear the source ('status' bits) */
	$0

	return IRQ_HANDLED;
}

/* In probe(): */
ret = devm_request_threaded_irq(dev, client->irq, NULL, $1_irq_thread,
				IRQF_ONESHOT, dev_name(dev), priv);
if (ret)
	return dev_err_probe(dev, ret, "failed to request IRQ %d\n", client->irq);
endsnippet


# ============================================================================
# [8]  DEVICE TREE NODES
# ============================================================================

# trigger: dtnode
# MMIO platform device node. 'reg' cell count must match the PARENT bus's
# #address-cells / #size-cells (arm64 SoC buses: usually 2/2 → <0x0 addr 0x0 size>;
# arm32 or simple-bus with 1/1 → <addr size>).
snippet dtnode "DTS device node for a platform device" b
${1:label}: ${2:generic-name}@${3:10000000} {
	compatible = "${4:vendor,device}";
	reg = <${5:0x0 0x$3 0x0 0x${6:1000}}>;
	interrupts = <GIC_SPI ${7:42} IRQ_TYPE_LEVEL_HIGH>;
	clocks = <&${8:cru} ${9:CLK_ID}>;
	resets = <&$8 ${10:SRST_ID}>;
	status = "${11:disabled}";
	$0
};
endsnippet

# trigger: dti2c
# I2C device node, added to a bus from the board .dts.
# Unit address = 7-bit address in hex without 0x (e.g. @48).
snippet dti2c "DTS I2C device node" b
&${1:i2c0} {
	status = "okay";

	${2:sensor}@${3:48} {
		compatible = "${4:vendor,device}";
		reg = <0x$3>;
		interrupts-extended = <&${5:gpio1} ${6:5} ${7:IRQ_TYPE_LEVEL_LOW}>;
		reset-gpios = <&${8:gpio1} ${9:6} GPIO_ACTIVE_LOW>;
		vdd-supply = <&${10:vcc_3v3}>;
		$0
	};
};
endsnippet

# trigger: dtspi
# SPI device node. The SPI mode lives HERE (spi-cpol / spi-cpha), not in the
# driver: mode 0 = neither, 1 = cpha, 2 = cpol, 3 = both.
snippet dtspi "DTS SPI device node" b
&${1:spi0} {
	status = "okay";

	${2:adc}@${3:0} {
		compatible = "${4:vendor,device}";
		reg = <$3>;			/* chip select */
		spi-max-frequency = <${5:1000000}>;
		${6:/* spi-cpol; spi-cpha;   (mode 3) */}
		$0
	};
};
endsnippet

# trigger: dtgpio
# GPIO consumer property (driver: devm_gpiod_get(dev, "name", ...)).
snippet dtgpio "DTS GPIO consumer property" b
${1:enable}-gpios = <&${2:gpio1} ${3:0} ${4:GPIO_ACTIVE_HIGH}>;
$0
endsnippet

# trigger: dtpinctrl
# pinctrl reference pair.
snippet dtpinctrl "DTS pinctrl properties" b
pinctrl-names = "default";
pinctrl-0 = <&${1:uart2_pins}>;
$0
endsnippet

# trigger: dtovl
# Device tree overlay (.dtso) skeleton.
snippet dtovl "DT overlay skeleton" b
/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

&${1:i2c1} {
	status = "okay";
	$0
};
endsnippet


# ============================================================================
# [9]  DEBUG & LOGGING
# ============================================================================

# trigger: pri
# pr_info — general kernel log (no device context; pr_fmt adds the prefix)
snippet pri "pr_info log message" b
pr_info("${1:message}\n"${2:, args});
$0
endsnippet

# trigger: pre
# pr_err — kernel error log
snippet pre "pr_err error message" b
pr_err("${1:error message}: %d\n", ${2:ret});
$0
endsnippet

# trigger: devi
# dev_info — log with device context (preferred in drivers)
snippet devi "dev_info with device context" b
dev_info(${1:dev}, "${2:message}\n"${3:, args});
$0
endsnippet

# trigger: deve
# dev_err — device-context error log
snippet deve "dev_err with device context" b
dev_err(${1:dev}, "${2:error message}: %d\n", ${3:ret});
$0
endsnippet

# trigger: deprobe
# dev_err_probe — error return in probe(). Silent for -EPROBE_DEFER (records
# the reason in /sys/kernel/debug/devices_deferred instead of spamming dmesg).
snippet deprobe "return dev_err_probe(...)" b
return dev_err_probe(${1:dev}, ${2:ret}, "${3:failed to ...}\n");
$0
endsnippet

# trigger: devd
# dev_dbg — enable at runtime without rebuilding:
#   echo 'file my_driver.c +p' > /sys/kernel/debug/dynamic_debug/control
snippet devd "dev_dbg debug message (dynamic debug)" b
dev_dbg(${1:dev}, "${2:debug message}\n"${3:, args});
$0
endsnippet

# trigger: devw
# dev_warn — device warning
snippet devw "dev_warn warning message" b
dev_warn(${1:dev}, "${2:warning message}\n"${3:, args});
$0
endsnippet

# trigger: dbg
# pr_debug with function/line (dynamic debug: +p as above)
snippet dbg "pr_debug with file/line context" b
pr_debug("%s:%d ${1:message}\n", __func__, __LINE__${2:, args});
$0
endsnippet

# trigger: WARN
# WARN_ON — prints a stack trace once per call site (debug assertion)
snippet WARN "WARN_ON_ONCE assertion" b
if (WARN_ON_ONCE(${1:condition}))
	return ${2:-EINVAL};
$0
endsnippet


# ============================================================================
# [10]  COMMON KERNEL PATTERNS
# ============================================================================

# trigger: devm
# devm_kzalloc — the standard way to allocate private driver data
snippet devm "devm_kzalloc private data allocation" b
${1:priv} = devm_kzalloc(${2:dev}, sizeof(*$1), GFP_KERNEL);
if (!$1)
	return -ENOMEM;
$0
endsnippet

# trigger: ofprop
# device_property_read_u32 — works for DT and ACPI (fwnode API)
snippet ofprop "device_property_read_u32 from firmware" b
ret = device_property_read_u32(${1:dev}, "${2:property-name}", &${3:value});
if (ret)
	return dev_err_probe($1, ret, "missing '$2' property\n");
$0
endsnippet

# trigger: ofpropopt
# Optional property with a default value
snippet ofpropopt "optional device property with default" b
${1:value} = ${2:default};
device_property_read_u32(${3:dev}, "${4:property-name}", &$1);
$0
endsnippet

# trigger: mutex
# guard(mutex) — the lock is released automatically at end of scope (6.5+).
snippet mutex "scoped mutex guard" b
guard(mutex)(&${1:priv}->${2:lock});
$0
endsnippet

# trigger: mutexl
# Classic mutex_lock / unlock pair
snippet mutexl "mutex_lock/unlock pair" b
mutex_lock(&${1:priv}->${2:lock});
${3:/* critical section */}
mutex_unlock(&$1->$2);
$0
endsnippet

# trigger: spinl
# spin_lock_irqsave / spin_unlock_irqrestore (data shared with an IRQ handler)
snippet spinl "spin_lock_irqsave / spin_unlock_irqrestore" b
unsigned long flags;

spin_lock_irqsave(&${1:priv}->${2:lock}, flags);
${3:/* critical section — cannot sleep here */}
spin_unlock_irqrestore(&$1->$2, flags);
$0
endsnippet

# trigger: regr
# regmap_read — read a hardware register via regmap
snippet regr "regmap_read register" b
ret = regmap_read(${1:priv}->regmap, ${2:REG_NAME}, &${3:val});
if (ret)
	return dev_err_probe($1->dev, ret, "failed to read $2\n");
$0
endsnippet

# trigger: regw
# regmap_write — write a hardware register via regmap
snippet regw "regmap_write register" b
ret = regmap_write(${1:priv}->regmap, ${2:REG_NAME}, ${3:val});
if (ret)
	return dev_err_probe($1->dev, ret, "failed to write $2\n");
$0
endsnippet

# trigger: regupd
# regmap_update_bits — set/clear specific bits in a register
snippet regupd "regmap_update_bits — modify specific register bits" b
ret = regmap_update_bits(${1:priv}->regmap, ${2:REG_NAME},
			 ${3:MASK}, FIELD_PREP($3, ${4:value}));
if (ret)
	return dev_err_probe($1->dev, ret, "failed to update $2\n");
$0
endsnippet

# trigger: regpoll
# Poll a register until a bit is set (e.g. PLL lock, reset done) with timeout.
snippet regpoll "regmap_read_poll_timeout" b
ret = regmap_read_poll_timeout(${1:priv}->regmap, ${2:REG_STATUS}, ${3:val},
			       ${4:$3 & STATUS_READY}, ${5:1000}, ${6:100000});
if (ret)
	return dev_err_probe($1->dev, ret, "timeout waiting for $2\n");
$0
endsnippet

# trigger: waitq
# wait_event_interruptible_timeout — block until condition or timeout
snippet waitq "wait_event_interruptible_timeout" b
/* priv struct:  wait_queue_head_t ${1:wq};                 */
/* probe():      init_waitqueue_head(&priv->$1);           */
/* IRQ handler:  wake_up_interruptible(&priv->$1);         */

ret = wait_event_interruptible_timeout(${2:priv}->$1, ${3:condition},
				       msecs_to_jiffies(${4:1000}));
if (ret == 0)
	return -ETIMEDOUT;
if (ret < 0)
	return ret;			/* -ERESTARTSYS: signal */
$0
endsnippet

# trigger: compl
# completion — wait for one event signalled from an IRQ handler
snippet compl "completion wait with timeout" b
/* priv struct: struct completion ${1:done}; probe(): init_completion(&priv->$1); */
/* IRQ handler: complete(&priv->$1);                                             */

reinit_completion(&${2:priv}->$1);
/* TODO: start the hardware operation */
if (!wait_for_completion_timeout(&$2->$1, msecs_to_jiffies(${3:100})))
	return -ETIMEDOUT;
$0
endsnippet


# ============================================================================
# [11]  MEMORY MANAGEMENT / DMA
# ============================================================================

# trigger: iomap
# Map an MMIO region from the DT 'reg' property (requests the region too)
snippet iomap "devm_platform_ioremap_resource" b
${1:priv}->base = devm_platform_ioremap_resource(${2:pdev}, ${3:0});
if (IS_ERR($1->base))
	return PTR_ERR($1->base);
$0
endsnippet

# trigger: dma
# DMA coherent buffer, device-managed (freed on unbind).
# Set the DMA mask first: a 32-bit DMA master on a 64-bit SoC with RAM
# above 4 GiB otherwise gets buffers it cannot reach.
snippet dma "dma_set_mask + dmam_alloc_coherent" b
ret = dma_set_mask_and_coherent(${1:dev}, DMA_BIT_MASK(${2:32}));
if (ret)
	return dev_err_probe($1, ret, "no suitable DMA mask\n");

${3:priv}->${4:buf} = dmam_alloc_coherent($1, ${5:size}, &$3->$4_dma, GFP_KERNEL);
if (!$3->$4)
	return -ENOMEM;
$0
endsnippet


# ============================================================================
# [12]  MISCELLANEOUS C PATTERNS
# ============================================================================

# trigger: ifnull
# NULL check with error return
snippet ifnull "NULL pointer check" b
if (!${1:ptr})
	return ${2:-EINVAL};
$0
endsnippet

# trigger: retcheck
# Return value check pattern — used constantly in kernel code
snippet retcheck "Return value error check" b
ret = ${1:function}(${2:args});
if (ret)
	return dev_err_probe(${3:dev}, ret, "$1 failed\n");
$0
endsnippet

# trigger: bfield
# Bit field operations using BIT(), GENMASK(), FIELD_GET/FIELD_PREP
snippet bfield "Bit field macros — BIT, GENMASK, FIELD_GET/PREP" b
#include <linux/bitfield.h>

/* Single bit */
#define ${1:REG}_${2:FLAG}		BIT(${3:0})

/* Multi-bit field: bits [${5:7}:${6:4}] */
#define $1_${4:FIELD}_MASK	GENMASK($5, $6)

/* val = FIELD_GET($1_$4_MASK, reg);  reg |= FIELD_PREP($1_$4_MASK, val); */
$0
endsnippet

# trigger: foreach
# list_for_each_entry — iterate a kernel linked list
snippet foreach "list_for_each_entry kernel list iteration" b
list_for_each_entry(${1:entry}, &${2:head}, ${3:list_member}) {
	$0
}
endsnippet

# trigger: miscdev
# misc device — the simplest way to get a /dev node (no cdev/class boilerplate)
snippet miscdev "miscdevice registration" b
#include <linux/miscdevice.h>
#include <linux/fs.h>

static const struct file_operations ${1:drv}_fops = {
	.owner          = THIS_MODULE,
	.open           = $1_open,
	.release        = $1_release,
	.read           = $1_read,
	.write          = $1_write,
	.unlocked_ioctl = $1_ioctl,
};

/* In probe(): creates /dev/$1 */
priv->miscdev.minor  = MISC_DYNAMIC_MINOR;
priv->miscdev.name   = "$1";
priv->miscdev.fops   = &$1_fops;
priv->miscdev.parent = dev;
ret = misc_register(&priv->miscdev);
if (ret)
	return dev_err_probe(dev, ret, "misc_register failed\n");

/* In remove(): */
misc_deregister(&priv->miscdev);
$0
endsnippet

# trigger: cdev
# Character device with its own major number and class (6.4+ class_create).
snippet cdev "Character device (cdev) registration" b
#include <linux/cdev.h>
#include <linux/device.h>
#include <linux/fs.h>

static dev_t ${1:drv}_devno;
static struct cdev $1_cdev;
static struct class *$1_class;

static const struct file_operations $1_fops = {
	.owner          = THIS_MODULE,
	.open           = $1_open,
	.release        = $1_release,
	.read           = $1_read,
	.write          = $1_write,
	.unlocked_ioctl = $1_ioctl,
};

static int __init $1_init(void)
{
	struct device *dev;
	int ret;

	ret = alloc_chrdev_region(&$1_devno, 0, 1, "$1");
	if (ret)
		return ret;

	cdev_init(&$1_cdev, &$1_fops);
	ret = cdev_add(&$1_cdev, $1_devno, 1);
	if (ret)
		goto err_region;

	$1_class = class_create("$1");
	if (IS_ERR($1_class)) {
		ret = PTR_ERR($1_class);
		goto err_cdev;
	}

	dev = device_create($1_class, NULL, $1_devno, NULL, "$1");
	if (IS_ERR(dev)) {
		ret = PTR_ERR(dev);
		goto err_class;
	}
	return 0;

err_class:
	class_destroy($1_class);
err_cdev:
	cdev_del(&$1_cdev);
err_region:
	unregister_chrdev_region($1_devno, 1);
	return ret;
}

static void __exit $1_exit(void)
{
	device_destroy($1_class, $1_devno);
	class_destroy($1_class);
	cdev_del(&$1_cdev);
	unregister_chrdev_region($1_devno, 1);
}
$0
endsnippet
